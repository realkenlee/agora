DATABASE_URL=postgresql://postgres:password@localhost:5432/agora

# Stripe — pull via `stripe projects env --pull` (or set in Railway).
# Never paste secret keys into chat.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_CONNECT_COUNTRY=US
# Optional overrides; defaults use WEB_URL
# STRIPE_CONNECT_REFRESH_URL=
# STRIPE_CONNECT_RETURN_URL=

WEB_URL=http://localhost:3000

# Paid LLM (recommended). Free OpenRouter :free models cap at 50 req/day
# and will sink listing drafts.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
VISION_MODEL=
# OPENROUTER_API_KEY=   # legacy fallback only; prefer LLM_API_KEY

# Optional
TELEGRAM_BOT_TOKEN=
SECRET_KEY=change-me-in-production
